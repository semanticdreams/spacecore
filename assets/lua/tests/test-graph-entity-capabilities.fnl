(local Graph (require :graph/init))
(local GraphMap (require :graph/map))
(local Registry (require :graph/extension-registry))
(local Entities (require :graph/extensions/builtins/entities))
(local Strings (require :entities/string))
(local Links (require :entities/link))
(local Identities (require :entities/identity))
(local tempfile (require :tempfile))
(local process (require :process))
(local Uuid (require :uuid))
(local json (require :json))
(local fs (require :fs))
(local Shapes (require :graph/capability-shapes))
(local Relationships (require :entities/relationships))
(local RecordFiles (require :entities/record-files))
(local tests [])

(fn value! [result]
  (assert result.ok (json.dumps result))
  result.value)

(fn family-directory []
  (if (not= (string.sub package.config 1 1) "/")
      (tempfile.TemporaryDirectory {:prefix "graph-capabilities-"})
      (do
        (local path (fs.join-path "/tmp" (.. "graph-capabilities-" (Uuid.v4))))
        (local made (process.run {:args ["mkdir" "-m" "700" path] :timeout 10}))
        (assert (= made.exit-code 0) made.stderr)
        (each [_ child (ipairs ["entities" "entities/string" "entities/link"])]
          (local created (process.run {:args ["mkdir" "-m" "700" (fs.join-path path child)] :timeout 10}))
          (assert (= created.exit-code 0) created.stderr))
        {:path path :drop (fn drop-directory [_self] (fs.remove-all path))})))

(fn with-family [events? f]
  (local dir (family-directory))
  (local string-files (collect [key value (pairs RecordFiles)] (values key value)))
  (local link-files (collect [key value (pairs RecordFiles)] (values key value)))
  (local strings (Strings.StringEntityStore {:base-dir dir.path :files string-files}))
  (local identities (Identities.IdentityStore {:base-dir dir.path}))
  (local links (Links.LinkEntityStore {:base-dir dir.path :files link-files :identity-store identities}))
  (local options {:string-store strings :link-store links :identity-store identities
                  :code-store {} :list-store {} :dict-store {} :notebook-store {}
                  :entity-type-catalog {}})
  (local graph (Graph {:entity-events? events? :string-store strings :link-store links
                      :identity-store identities :morphs {}}))
  (local registry (Registry.GraphExtensionRegistry {:app {}}))
  (local handle (registry:register-extension (. (Entities.descriptors options) 1)))
  (local runtime {:graph graph})
  (registry:install-runtime runtime)
  (local (ok err) (pcall f graph strings links identities dir.path string-files link-files registry runtime))
  (registry:uninstall-runtime runtime)
  (handle:unregister)
  (graph:drop)
  (dir:drop)
  (when (not ok) (error (if (= (type err) :table) (json.dumps err) err))))

;; Consumers select by advertised capability, never by concrete key/type.
(fn capability! [graph ref id]
  (local description (value! (graph:describe ref)))
  (var found nil)
  (each [_ metadata (ipairs description.capabilities)]
    (when (= metadata.id id) (set found metadata)))
  (assert found (.. "missing advertised capability " id))
  found)

(fn provider! [graph id]
  (var found nil)
  (each [_ entry (ipairs (. (value! (graph:discover {})) :items))]
    (each [_ metadata (ipairs (. (value! (graph:describe entry.ref)) :capabilities))]
      (when (= metadata.id id) (set found entry.ref))))
  (assert found (.. "discovery must expose " id))
  found)

(fn call! [graph ref id args pre]
  (local metadata (capability! graph ref id))
  (assert (= metadata.effect (if (or (= id "collection.create") (= id "text.replace")
                                   (= id "relationships.create")) :write :read)))
  (local value (value! (graph:invoke ref metadata.id args (or pre {}))))
  (Shapes.check! metadata.result value))

(fn no-visual-call [& _] (error "nonvisual workflow invoked visual resolution"))

(fn forbid-visuals! [graph]
  (set graph.load-by-key no-visual-call)
  (set graph.create-node-by-key no-visual-call)
  (set graph.resolve-key no-visual-call)
  (set graph.resolve-node no-visual-call))

(fn workflow [graph strings links _identities base-dir]
  (strings:create-entity {:id "brief" :value "Project brief: literal [scope]."})
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.search"))
  (local relationships (provider! graph "relationships.create"))
  (local page (call! graph collection "collection.search" {:query "[scope]"}))
  (assert (= (length page.items) 1))
  (local brief (. page.items 1 :ref))
  (assert (= (. (call! graph brief "text.read" {}) :text) "Project brief: literal [scope]."))
  (assert (= (length (. (call! graph relationships "relationships.list" {:subject brief}) :items)) 0))
  (local first (call! graph collection "collection.create" {:text "  note\n\n"}))
  (local second (call! graph collection "collection.create" {:text "第二 note\r\n"}))
  (local relation (call! graph relationships "relationships.create" {:source brief :target first.ref}))
  (call! graph relationships "relationships.create" {:source brief :target second.ref})
  (local description (value! (graph:describe relation.ref)))
  (assert (= (length description.capabilities) 0) "link records must not advertise incidental CRUD")
  (assert (string.find description.summary brief.key 1 true))
  (assert (string.find description.summary first.ref.key 1 true))
  (local read (call! graph first.ref "text.read" {}))
  (assert (= read.text "  note\n\n"))
  (local replaced (call! graph first.ref "text.replace" {:text " updated\n\n"} {:revision read.revision}))
  (assert (not= replaced.revision read.revision))
  (assert (= (. (call! graph first.ref "text.read" {}) :text) " updated\n\n"))
  (local related (call! graph relationships "relationships.list" {:subject brief}))
  (assert (= (length related.items) 2))
  (each [_ item (ipairs related.items)] (assert (= item.source.key brief.key)))
  (local reopened-strings (Strings.StringEntityStore {:base-dir base-dir}))
  (local reopened-identities (Identities.IdentityStore {:base-dir base-dir}))
  (local reopened-links (Links.LinkEntityStore {:base-dir base-dir :identity-store reopened-identities}))
  (local reopened (Graph {:entity-events? false :string-store reopened-strings
                          :link-store reopened-links :identity-store reopened-identities :morphs {}}))
  (local access ((. (require :graph/capabilities/entities) :access-by-scheme)
                 {:string-store reopened-strings :link-store reopened-links}))
  (each [scheme provider (pairs access)]
    (reopened:register-key-loader scheme no-visual-call {:access provider}))
  (assert (= (. (value! (reopened:invoke first.ref "text.read" {} {})) :text) " updated\n\n"))
  (assert (= (. (value! (reopened:invoke first.ref "text.read" {} {})) :revision) replaced.revision))
  (assert (= (. (value! (reopened:invoke second.ref "text.read" {} {})) :text) "第二 note\r\n"))
  (assert (= (. (value! (reopened:invoke second.ref "text.read" {} {})) :revision) second.revision))
  (local persisted (value! (reopened:invoke relationships "relationships.list" {:subject brief} {})))
  (assert (= (json.dumps persisted) (json.dumps related)))
  (assert (= (graph:node-count) 0))
  (assert (= (graph:edge-count) 0))
  (reopened:drop))

(fn complete-workflow []
  (each [_ events? (ipairs [true false])]
    (with-family events? workflow)))

(fn error! [result code outcome]
  (assert (not result.ok) "expected failure")
  (assert (= result.error.code code) (json.dumps result))
  (assert (= result.error.outcome outcome) (json.dumps result))
  result.error)

(fn boundary-cases [graph strings _links _identities base-dir]
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.create"))
  (local relations (provider! graph "relationships.create"))
  (local created (call! graph collection "collection.create" {:text ""}))
  (assert (= (. (call! graph created.ref "text.read" {}) :text) ""))
  (local max-text (string.rep "x" 65536))
  (local large (call! graph collection "collection.create" {:text max-text}))
  (assert (= (. (call! graph large.ref "text.read" {}) :text) max-text))
  (each [_ args (ipairs [{:text (string.rep "x" 65537)} {:text "x" :extra true}
                         {:text (string.char 255)}])]
    (error! (graph:invoke collection "collection.create" args {}) :invalid-arguments :not-committed))
  (each [_ query (ipairs ["" (string.rep "x" 257) (string.char 255)])]
    (error! (graph:invoke collection "collection.search" {:query query} {}) :invalid-arguments :not-committed))
  (each [_ limit (ipairs [0 51 1.5])]
    (error! (graph:invoke collection "collection.list" {:limit limit} {}) :invalid-arguments :not-committed))
  (error! (graph:invoke created.ref "text.replace" {:text "new"} {}) :invalid-arguments :not-committed)
  (error! (graph:invoke created.ref "text.read" {} {:revision created.revision}) :invalid-arguments :not-committed)
  (local read (call! graph created.ref "text.read" {}))
  (call! graph created.ref "text.replace" {:text "new"} {:revision read.revision})
  (local conflict (error! (graph:invoke created.ref "text.replace" {:text "lost"} {:revision read.revision})
                         :conflict :not-committed))
  (assert (= conflict.current-revision (. (call! graph created.ref "text.read" {}) :revision)))
  (assert (= (. (call! graph created.ref "text.read" {}) :text) "new"))
  (error! (graph:describe {:key "string-entity:missing"}) :not-found :not-committed)
  (error! (graph:describe {:key "link-entity:missing"}) :not-found :not-committed)
  (error! (graph:describe {:key (.. "string-entity:" (string.rep "x" 243))}) :invalid-arguments :not-committed)
  (each [_ ref (ipairs [{:key "string-entity:missing"} {:key "identity:hidden"}
                        {:key "string-entity:../escape"} {:key "string-entity-list"}])]
    (local expected (if (= ref.key "string-entity:missing") :not-found :invalid-arguments))
    (error! (graph:invoke relations "relationships.create" {:source created.ref :target ref} {}) expected :not-committed)
    (error! (graph:invoke relations "relationships.create" {:source ref :target created.ref} {}) expected :not-committed))
  (local description (value! (graph:describe collection)))
  (set (. description.capabilities 1 :arguments :fields :limit :max) 999)
  (set description.summary "mutated")
  (error! (graph:invoke collection "collection.list" {:limit 51} {}) :invalid-arguments :not-committed)
  (assert (not= (. (value! (graph:describe collection)) :summary) "mutated"))
  (local multi (strings:create-entity {:id "unicode" :value (.. (string.rep "a" 159) "界end")}))
  (local listed (call! graph collection "collection.search" {:query "界"}))
  (assert (= (. listed.items 1 :summary) (string.rep "a" 159)))
  (assert (utf8.len (. listed.items 1 :summary)))
  (local exact (strings:create-entity {:id "exact" :value "[a].%Case"}))
  (assert (= (length (. (call! graph collection "collection.search" {:query "[a].%"}) :items)) 1))
  (assert (= (length (. (call! graph collection "collection.search" {:query "case"}) :items)) 0))
  (assert (= (length (. (call! graph collection "collection.search" {:query "unicode"}) :items)) 0)
          "search must not include record ids or frontmatter")
  (local query256 (string.rep "x" 256))
  (assert (= (length (. (call! graph collection "collection.search" {:query query256}) :items)) 1))
  (local max-id (string.rep "k" 242))
  ;; An existing maximum-length reference must support the advertised replace,
  ;; not just read. Its final Markdown filename fits POSIX NAME_MAX.
  (local fixture (assert (io.open (fs.join-path strings.entities-dir (.. max-id ".md")) "wb")))
  (assert (fixture:write (.. "---\nid: " max-id "\ncreated-at: 1\nupdated-at: 1\n---\n\nmaximum reference")))
  (assert (fixture:close))
  (local max-ref {:key (.. "string-entity:" max-id)})
  (assert (= (length max-ref.key) 256))
  (local max-before (call! graph max-ref "text.read" {}))
  (assert (= max-before.text "maximum reference"))
  (local max-after-text "  maximum reference replaced 雪\r\n\n")
  (local max-after (call! graph max-ref "text.replace" {:text max-after-text} {:revision max-before.revision}))
  (assert (= max-after.ref.key max-ref.key))
  (assert (not= max-after.revision max-before.revision))
  (local reopened (Strings.StringEntityStore {:base-dir base-dir}))
  (local persisted (reopened:read-text max-id))
  (assert (= persisted.value max-after-text))
  (assert (= persisted.revision max-after.revision))
  (error! (graph:invoke max-ref "text.replace" {:text "stale maximum"} {:revision max-before.revision})
          :conflict :not-committed)
  (assert (= (. (call! graph max-ref "text.read" {}) :text) max-after-text))
  (strings:create-entity {:id "large-body" :value (string.rep "x" 65537)})
  (error! (graph:invoke {:key "string-entity:large-body"} "text.read" {} {}) :limit-exceeded :not-committed)
  (strings:create-entity {:id "invalid-utf8" :value (string.char 255)})
  (error! (graph:describe {:key "string-entity:invalid-utf8"}) :corrupt-data :not-committed)
  (error! (graph:invoke collection "collection.list" {} {}) :corrupt-data :not-committed)
  (assert multi.id)
  (assert exact.id))

(fn bounded-pages [graph strings links _identities _base-dir]
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.search"))
  (local relations (provider! graph "relationships.list"))
  (for [i 1 201]
    (strings:create-entity {:id (string.format "r%03d" i) :value (if (= i 201) "needle" "hay")})
    (links:create-entity {:id (string.format "l%03d" i) :source-key "other:source"
                          :target-key (if (= i 201) "subject:key" "other:target")}))
  (local scan-text strings.scan-page)
  (local scan-links links.scan-page)
  (local examined [])
  (fn track [store scan opts]
    (assert (= opts.examined-limit 200))
    (assert (<= opts.limit 50))
    (local page (scan store opts))
    (assert (<= page.examined 200))
    (table.insert examined page.examined)
    page)
  (set strings.scan-page (fn scan [self opts] (track self scan-text opts)))
  (set links.scan-page (fn scan [self opts] (track self scan-links opts)))
  (local first (call! graph collection "collection.search" {:query "needle"}))
  (assert (= (length first.items) 0))
  (assert first.has-more)
  (assert first.cursor)
  (assert (= (. examined 1) 200))
  (local last (call! graph collection "collection.search" {:query "needle" :cursor first.cursor}))
  (assert (= (length last.items) 1))
  (assert (not last.has-more))
  (assert (= last.cursor nil))
  (assert (= (. examined 2) 1) "continuation must use the last examined, not last matched id")
  (local escaped-query (string.rep "\0" 256))
  (local escaped (call! graph collection "collection.search" {:query escaped-query}))
  (assert escaped.has-more)
  (assert (<= (length escaped.cursor) 2048))
  (assert (not (. (call! graph collection "collection.search" {:query escaped-query :cursor escaped.cursor}) :has-more)))
  (local listing (call! graph collection "collection.list" {:limit 50}))
  (assert (= (length listing.items) 50))
  (assert listing.has-more)
  (assert (= (. listing.items 1 :ref :key) "string-entity:r001"))
  (local next-list (call! graph collection "collection.list" {:limit 1 :cursor listing.cursor}))
  (assert (= (. next-list.items 1 :ref :key) "string-entity:r051"))
  (error! (graph:invoke collection "collection.search" {:query "hay" :cursor first.cursor} {}) :invalid-arguments :not-committed)
  (error! (graph:invoke collection "collection.list" {:cursor first.cursor} {}) :invalid-arguments :not-committed)
  (local subject {:key "subject:key"})
  (local incident (call! graph relations "relationships.list" {:subject subject}))
  (assert (= (length incident.items) 0))
  (assert incident.has-more)
  (local tail (call! graph relations "relationships.list" {:subject subject :cursor incident.cursor}))
  (assert (= (length tail.items) 1))
  (assert (= (. tail.items 1 :source :key) "other:source"))
  (assert (= (. tail.items 1 :target :key) subject.key))
  (error! (graph:invoke relations "relationships.list" {:subject {:key "other:target"} :cursor incident.cursor} {})
          :invalid-arguments :not-committed)
  (error! (graph:invoke relations "relationships.list" {:subject subject :cursor first.cursor} {})
          :invalid-arguments :not-committed)
  ;; Closed cursor payload, version, reference and last-examined validation.
  (local payload (json.loads (string.sub first.cursor 4)))
  (each [_ malformed (ipairs ["v2:any" "v1:not-json" "v1:[]" "v1:{}"])]
    (error! (graph:invoke collection "collection.search" {:query "needle" :cursor malformed} {}) :invalid-arguments :not-committed))
  (set payload.extra true)
  (error! (graph:invoke collection "collection.search" {:query "needle" :cursor (.. "v1:" (json.dumps payload))} {})
          :invalid-arguments :not-committed)
  (set payload.extra nil)
  (set payload.key "another-ref")
  (error! (graph:invoke collection "collection.search" {:query "needle" :cursor (.. "v1:" (json.dumps payload))} {})
          :invalid-arguments :not-committed)
  (set payload.key collection.key)
  (set payload.after-id "../escape")
  (error! (graph:invoke collection "collection.search" {:query "needle" :cursor (.. "v1:" (json.dumps payload))} {})
          :invalid-arguments :not-committed))

(fn direct-links [graph strings links identities _base-dir]
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.create"))
  (local relations (provider! graph "relationships.list"))
  (local a (call! graph collection "collection.create" {:text "A"}))
  (local b (call! graph collection "collection.create" {:text "B"}))
  (local alias (identities:create-entity {:id "alias" :target-key a.ref.key}))
  (local alias-key (.. "identity:" alias.id))
  (links:create-entity {:id "indirect" :source-key alias-key :target-key b.ref.key})
  (local direct (call! graph relations "relationships.create" {:source b.ref :target a.ref}))
  (local duplicate (call! graph relations "relationships.create" {:source b.ref :target a.ref}))
  (local link-bytes
    (collect [_ ref (ipairs [{:key "link-entity:indirect"} direct.ref duplicate.ref])]
      ref.key (fs.read-file (fs.join-path links.entities-dir (.. (string.sub ref.key 13) ".json")))))
  (local page (call! graph relations "relationships.list" {:subject a.ref}))
  (assert (= (length page.items) 3) "alias-inclusive incident matching keeps every directed link ID")
  (local by-ref (collect [_ item (ipairs page.items)] item.ref.key item))
  (assert (= (. by-ref direct.ref.key :source :key) b.ref.key))
  (assert (= (. by-ref duplicate.ref.key :target :key) a.ref.key))
  (assert (= (. by-ref "link-entity:indirect" :source :key) a.ref.key))
  (local raw-alias (call! graph relations "relationships.list" {:subject {:key alias-key}}))
  (assert (= (length raw-alias.items) 3))
  (identities:update-entity "alias" {:target-key "terminal:retargeted"})
  (local retargeted (call! graph relations "relationships.list" {:subject {:key "terminal:retargeted"}}))
  (assert (= (length retargeted.items) 3) "all three links reuse the retargeted owner alias")
  (local retargeted-by-ref (collect [_ item (ipairs retargeted.items)] item.ref.key item))
  (each [_ spec (ipairs [["link-entity:indirect" "terminal:retargeted" b.ref.key]
                         [direct.ref.key b.ref.key "terminal:retargeted"]
                         [duplicate.ref.key b.ref.key "terminal:retargeted"]])]
    (local item (assert (. retargeted-by-ref (. spec 1)) "exact retargeted link ID must survive"))
    (assert (= item.source.key (. spec 2)) "retargeting must preserve source direction")
    (assert (= item.target.key (. spec 3)) "retargeting must preserve target direction")
    (assert (= (. link-bytes item.ref.key)
               (fs.read-file (fs.join-path links.entities-dir (.. (string.sub item.ref.key 13) ".json"))))
            "retargeting must not rewrite any of the three persisted links"))
  (local description (value! (graph:describe {:key "link-entity:indirect"})))
  (assert (string.find description.summary "terminal:retargeted" 1 true))
  (assert (= (. link-bytes "link-entity:indirect") (fs.read-file (fs.join-path links.entities-dir "indirect.json")))
          "read projection and identity retargeting never rewrite link bytes")
  (local first (call! graph relations "relationships.list" {:subject b.ref :limit 1}))
  (assert first.has-more)
  (local equivalent-subject {:key (. (links:read-link (string.sub direct.ref.key 13)) :source-key)})
  (assert (= (identities:resolve-key equivalent-subject.key) b.ref.key))
  (error! (graph:invoke relations "relationships.list"
                      {:subject equivalent-subject :cursor first.cursor} {}) :invalid-arguments :not-committed)
  (local (ok _err) (pcall Relationships.create! strings links {:key alias-key} b.ref))
  (assert (not ok) "shared domain boundary rejects unsupported endpoint independently of graph"))

(fn throw-listener [_entity] (error "intentional post-commit listener failure"))
(fn throw-storage [& _] (error "intentional storage fault"))

(fn committed-cleanup [graph strings links _identities _base-dir string-files link-files]
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.create"))
  (local relations (provider! graph "relationships.create"))
  (local source (call! graph collection "collection.create" {:text "before"}))
  (local other (call! graph collection "collection.create" {:text "other"}))
  (local boundary (RecordFiles.RecordFiles
    {:publication-hooks {:test-before-cleanup (fn cleanup-fault [] (error "graph cleanup fault"))}}))
  (set string-files.write-text! boundary.write-text!)
  (set link-files.write-json! boundary.write-json!)
  (each [_ notification? (ipairs [false true])]
    (local observed {:calls 0 :completed false})
    (fn listener [entity]
      (set observed.calls (+ observed.calls 1))
      (assert (= (strings:get-entity entity.id) entity))
      (assert (= (. (strings:read-text entity.id) :revision) entity.revision))
      (set observed.completed true)
      (when notification? (error "graph notification fault")))
    (local handler (strings.string-entity-created:connect listener))
    (local created (graph:invoke collection "collection.create" {:text "committed"} {}))
    (strings.string-entity-created:disconnect handler true)
    (assert observed.completed "graph listener assertions did not complete")
    (assert (= observed.calls 1))
    (local create-error (error! created :storage-failed :committed))
    (assert (= create-error.cleanup-error nil) "local diagnostics must not extend graph errors")
    (assert (= create-error.notification-error nil))
    (assert (= (. (call! graph create-error.result.ref "text.read" {}) :text) "committed"))
    (local revision (. (call! graph source.ref "text.read" {}) :revision))
    (local update-handler (when notification? (strings.string-entity-updated:connect throw-listener)))
    (local replaced (graph:invoke source.ref "text.replace" {:text "replaced"} {:revision revision}))
    (when update-handler (strings.string-entity-updated:disconnect update-handler true))
    (local replace-error (error! replaced :storage-failed :committed))
    (assert (= replace-error.result.ref.key source.ref.key))
    (assert (= replace-error.result.revision (. (call! graph source.ref "text.read" {}) :revision)))
    (local link-handler (when notification? (links.link-entity-created:connect throw-listener)))
    (local linked (graph:invoke relations "relationships.create" {:source source.ref :target other.ref} {}))
    (when link-handler (links.link-entity-created:disconnect link-handler true))
    (local link-error (error! linked :storage-failed :committed))
    (assert (= link-error.result.source.key source.ref.key))
    (assert (= link-error.result.target.key other.ref.key))
    (set link-error.result.source.key "detached")
    (assert (= (links.identity-store:resolve-key
                 (. (links:read-link (string.sub link-error.result.ref.key 13)) :source-key)) source.ref.key))))

(fn failures [graph strings links _identities base-dir string-files link-files]
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.create"))
  (local relations (provider! graph "relationships.create"))
  (local source (call! graph collection "collection.create" {:text "before"}))
  (local other (call! graph collection "collection.create" {:text "other"}))
  (local writer string-files.write-text!)
  (set string-files.write-text! throw-storage)
  (error! (graph:invoke collection "collection.create" {:text "not written"} {}) :storage-failed :not-committed)
  (error! (graph:invoke source.ref "text.replace" {:text "not replaced"} {:revision source.revision}) :storage-failed :not-committed)
  (set string-files.write-text! writer)
  (assert (= (. (call! graph source.ref "text.read" {}) :text) "before"))
  (assert (= (. (call! graph source.ref "text.read" {}) :revision) source.revision))
  (local link-writer link-files.write-json!)
  (set link-files.write-json! throw-storage)
  (error! (graph:invoke relations "relationships.create" {:source source.ref :target other.ref} {}) :storage-failed :not-committed)
  (set link-files.write-json! link-writer)
  (assert (= (length (links:list-entities)) 0))
  (local created-handler (strings.string-entity-created:connect throw-listener))
  (local created (error! (graph:invoke collection "collection.create" {:text "committed create"} {}) :notification-failed :committed))
  (strings.string-entity-created:disconnect created-handler true)
  (assert created.result.ref)
  (assert (= (. (call! graph created.result.ref "text.read" {}) :text) "committed create"))
  (local updated-handler (strings.string-entity-updated:connect throw-listener))
  (local replaced (error! (graph:invoke source.ref "text.replace" {:text "committed replace"} {:revision source.revision})
                         :notification-failed :committed))
  (strings.string-entity-updated:disconnect updated-handler true)
  (assert (= replaced.result.ref.key source.ref.key))
  (assert (= replaced.result.revision (. (call! graph source.ref "text.read" {}) :revision)))
  (assert (= (. (call! graph source.ref "text.read" {}) :text) "committed replace"))
  (local link-handler (links.link-entity-created:connect throw-listener))
  (local linked (error! (graph:invoke relations "relationships.create" {:source source.ref :target other.ref} {})
                       :notification-failed :committed))
  (links.link-entity-created:disconnect link-handler true)
  (assert (= linked.result.source.key source.ref.key))
  (assert (= linked.result.target.key other.ref.key))
  (assert (= (length (. (call! graph relations "relationships.list" {:subject source.ref}) :items)) 1))
  (local list-ids string-files.list-ids)
  (set string-files.list-ids throw-storage)
  (error! (graph:invoke collection "collection.list" {} {}) :storage-failed :not-committed)
  (set string-files.list-ids list-ids)
  (local link-list link-files.list-ids)
  (set link-files.list-ids throw-storage)
  (error! (graph:invoke relations "relationships.list" {:subject source.ref} {}) :storage-failed :not-committed)
  (set link-files.list-ids link-list)
  (local reader string-files.read!)
  (set string-files.read! throw-storage)
  (error! (graph:describe source.ref) :storage-failed :not-committed)
  (error! (graph:invoke collection "collection.search" {:query "anything"} {}) :storage-failed :not-committed)
  (set string-files.read! reader)
  (RecordFiles.write-text! (fs.join-path strings.entities-dir "broken.md") "not frontmatter")
  (error! (graph:invoke collection "collection.list" {} {}) :corrupt-data :not-committed)
  (RecordFiles.remove! (fs.join-path strings.entities-dir "broken.md"))
  (RecordFiles.write-text! (fs.join-path links.entities-dir "broken.json") "not json")
  (error! (graph:invoke relations "relationships.list" {:subject source.ref} {}) :corrupt-data :not-committed)
  (RecordFiles.remove! (fs.join-path links.entities-dir "broken.json"))
  (RecordFiles.write-text! (fs.join-path strings.entities-dir "oversize.md") (string.rep "x" 131073))
  (error! (graph:invoke collection "collection.list" {} {}) :limit-exceeded :not-committed)
  (RecordFiles.remove! (fs.join-path strings.entities-dir "oversize.md"))
  (local create strings.create-entity)
  (set strings.create-entity throw-storage)
  (error! (graph:invoke collection "collection.create" {:text "unknown"} {}) :internal-error :unknown)
  (set strings.create-entity (fn missing-outcome [_self _opts]
                               (error {:code :storage-failed :message "missing outcome"})))
  (error! (graph:invoke collection "collection.create" {:text "unknown"} {}) :storage-failed :unknown)
  (set strings.create-entity (fn malformed-failure [_self _opts]
                               (error {:code :notification-failed :message "unchecked result" :result {:id "bad" :revision false}})))
  (error! (graph:invoke collection "collection.create" {:text "unknown"} {}) :invalid-result :unknown)
  (set strings.create-entity (fn bad-result [_self _opts] {:id "bad" :revision false}))
  (error! (graph:invoke collection "collection.create" {:text "invalid"} {}) :invalid-result :committed)
  (set strings.create-entity create)
  (local reopened (Strings.StringEntityStore {:base-dir base-dir}))
  (assert (= (. (reopened:read-text (string.sub source.ref.key 15)) :value) "committed replace")))

(fn sentinel-map [graph strings links identities base-dir]
  (strings:create-entity {:id "visible-a" :value "visible A"})
  (strings:create-entity {:id "visible-b" :value "visible B"})
  (local map (GraphMap.GraphMap {:graph graph :id "sentinel"}))
  (local a (map:load-by-key "string-entity:visible-a"))
  (local b (map:load-by-key "string-entity:visible-b"))
  (map:add-edge (Graph.GraphEdge {:source a :target b}))
  (map:create-island {:id "sentinel-island" :kind "selection"
                     :members [a.key b.key] :state {:label "unchanged"}})
  (map:set-selected-node-keys [b.key a.key])
  (set map.focused_node_key b.key)
  (map:set-view-mode! "outline")
  (map:set-outline-root-keys! [a.key])
  (local before (json.dumps (map:capture-state)))
  (local string-module (require :graph/nodes/string-entity))
  (local link-module (require :graph/nodes/link-entity))
  (local make-string string-module.StringEntityNode)
  (local make-link link-module.LinkEntityNode)
  (set string-module.StringEntityNode no-visual-call)
  (set link-module.LinkEntityNode no-visual-call)
  (local (ok err) (pcall workflow graph strings links identities base-dir))
  (set string-module.StringEntityNode make-string)
  (set link-module.LinkEntityNode make-link)
  (when ok
    (local read (call! graph {:key a.key} "text.read" {}))
    (call! graph {:key a.key} "text.replace" {:text "changed visible label"} {:revision read.revision})
    (assert (= a.label "changed visible label") "existing subscribed adapters may reflect domain edits")
    (local provider (provider! graph "relationships.create"))
    (call! graph provider "relationships.create" {:source {:key b.key} :target {:key a.key}})
    (assert (= (map:node-count) 2))
    (assert (= (map:edge-count) 2) "domain-derived edge is allowed alongside the explicit edge")
    (assert (= before (json.dumps (map:capture-state)))
            "membership explicit edges selection focus islands and projection state must remain unchanged"))
  (map:drop)
  (when (not ok) (error err)))

(fn map-isolation []
  (each [_ events? (ipairs [true false])]
    (with-family events? sentinel-map)))

(fn registration-lifecycle [graph _strings _links _identities _base-dir _string-files _link-files registry runtime]
  (local collection (provider! graph "collection.create"))
  (local relations (provider! graph "relationships.create"))
  (registry:uninstall-runtime runtime)
  (assert (= (length (. (value! (graph:discover {})) :items)) 0))
  (error! (graph:describe collection) :unavailable :not-committed)
  (error! (graph:describe relations) :unavailable :not-committed)
  ;; Throw after publishing the first capability-bearing registration. Immediate
  ;; ctx recording must remove it even though the installer never returns handles.
  (local register graph.register-key-loader)
  (set graph.register-key-loader
       (fn fail-second [self scheme loader opts]
         (when (= scheme "code-entity") (error "intentional installer failure"))
         (register self scheme loader opts)))
  (local (ok err) (pcall registry.install-runtime registry runtime))
  (assert (not ok))
  (assert (string.find (tostring err) "intentional installer failure" 1 true))
  (error! (graph:describe {:key "string-entity:any"}) :unavailable :not-committed)
  (assert (= (length (. (value! (graph:discover {})) :items)) 0))
  (set graph.register-key-loader register)
  (registry:install-runtime runtime)
  (assert (= (length (. (value! (graph:discover {})) :items)) 2)))

(fn nonmatching-corrupt-text [graph strings _links _identities _base-dir]
  (forbid-visuals! graph)
  (local collection (provider! graph "collection.search"))
  (strings:create-entity {:id "corrupt-nonmatch" :value (string.char 255)})
  (error! (graph:invoke collection "collection.search" {:query "absent literal"} {}) :corrupt-data :not-committed))

(fn bounded-link-description [graph _strings links _identities _base-dir _string-files link-files]
  (forbid-visuals! graph)
  ;; Seed valid JSON without priming this store's legacy cache.
  (RecordFiles.write-json! (fs.join-path links.entities-dir "huge.json")
                          {:id "huge" :source-key "source:key" :target-key "target:key"
                           :created-at 1 :metadata {:payload (string.rep "x" 131072)}})
  (local read-file link-files.read!)
  (local reads {:count 0 :unbounded 0})
  (fn track-read [path maximum]
    (set reads.count (+ reads.count 1))
    (if (= maximum nil) (set reads.unbounded (+ reads.unbounded 1))
        (assert (= maximum 131072)))
    (read-file path maximum))
  (set link-files.read! track-read)
  (local ref {:key "link-entity:huge"})
  (error! (graph:describe ref) :limit-exceeded :not-committed)
  (assert (= reads.count 1))
  (assert (= reads.unbounded 0) "description must bound the first owning read")
  (error! (graph:describe ref) :limit-exceeded :not-committed)
  (assert (= reads.count 2) "failed description must not prime the legacy cache")
  (assert (= reads.unbounded 0)))

(fn bounded-link-defaults [_graph _strings links _identities _base-dir _string-files link-files]
  (local reads [])
  (fn read [path maximum]
    (table.insert reads maximum)
    (RecordFiles.read! path maximum))
  (set link-files.read! read)
  (local path (fs.join-path links.entities-dir "defaults.json"))
  (local bytes "{\"id\":\"defaults\"}")
  (RecordFiles.write-text! path bytes)
  (local expected (json.dumps {:id "defaults" :source-key "" :target-key "" :created-at 0 :metadata {}}))
  (assert (= (json.dumps (links:decode-entity bytes)) expected))
  (assert (= (json.dumps (links:read-link "defaults")) expected))
  (local page (links:scan-page {}))
  (assert (= (# page.items) 1))
  (assert (= (json.dumps (. page.items 1)) expected))
  (assert (= (# reads) 2))
  (each [_ maximum (ipairs reads)] (assert (= maximum 131072)))
  (assert (= (. links.cache "defaults") nil) "bounded reads must remain detached")
  (assert (= (fs.read-file path) bytes) "decoding defaults must not rewrite legacy bytes"))

(fn alias-dependencies [graph _strings links identities _base-dir]
  (forbid-visuals! graph)
  (identities:create-entity {:id "inner" :target-key "terminal:one"})
  (identities:create-entity {:id "outer" :target-key "identity:inner"})
  (links:create-entity {:id "chain" :source-key "identity:outer" :target-key "identity:missing"})
  (local relations (provider! graph "relationships.list"))
  (local page (call! graph relations "relationships.list" {:subject {:key "identity:inner"}}))
  (assert (= (length page.items) 1) "inner dependency must find an upstream authored alias")
  (assert (= (. page.items 1 :source :key) "terminal:one"))
  (assert (= (. page.items 1 :target :key) "identity:missing") "unresolved endpoint stays opaque")
  (local bytes (fs.read-file (fs.join-path links.entities-dir "chain.json")))
  (identities:update-entity "inner" {:target-key "identity:outer"})
  (error! (graph:invoke relations "relationships.list" {:subject {:key "identity:inner"}} {})
          :internal-error :not-committed)
  (error! (graph:describe {:key "link-entity:chain"}) :internal-error :not-committed)
  (assert (= bytes (fs.read-file (fs.join-path links.entities-dir "chain.json")))))

(fn alias-resolution-failures [graph _strings links identities _base-dir]
  (forbid-visuals! graph)
  (for [i 1 35]
    (identities:create-entity {:id (.. "depth-" i)
                              :target-key (if (= i 35) "terminal:deep" (.. "identity:depth-" (+ i 1)))}))
  (links:create-entity {:id "deep" :source-key "identity:depth-1" :target-key "opaque:target"})
  (error! (graph:describe {:key "link-entity:deep"}) :internal-error :not-committed)
  (identities:create-entity {:id "unreadable" :target-key "terminal:read"})
  (links:create-entity {:id "unreadable" :source-key "identity:unreadable" :target-key "opaque:target"})
  (tset identities.cache "unreadable" nil)
  (local H (require :tests/test-reference-lifecycle-helpers))
  (fn describe-unreadable []
    (error! (graph:describe {:key "link-entity:unreadable"}) :internal-error :not-committed))
  (H.with-fs-failure :read-file (fs.join-path identities.entities-dir "unreadable.json") describe-unreadable))

(table.insert tests {:name "family validates limits revisions detached metadata and supported endpoints"
                     :fn (fn boundaries [] (with-family true boundary-cases))})
(table.insert tests {:name "bounded scans and closed scoped cursors advance past empty pages"
                     :fn (fn pages [] (with-family false bounded-pages))})
(table.insert tests {:name "relationship projection follows owner aliases without rewriting direction or distinct IDs"
                     :fn (fn direct [] (with-family true direct-links))})
(table.insert tests {:name "owning faults and committed notifications map to declared detached outcomes"
                     :fn (fn faults [] (with-family true failures))})
(table.insert tests {:name "committed cleanup diagnostics retain existing graph DTOs without schema changes"
                     :fn (fn cleanup [] (with-family true committed-cleanup))})
(table.insert tests {:name "nonvisual workflow leaves sentinel GraphMap interaction and projection state unchanged"
                     :fn map-isolation})
(table.insert tests {:name "family registrations own access through runtime uninstall rollback and retry"
                     :fn (fn lifecycle [] (with-family false registration-lifecycle))})
(table.insert tests {:name "nonmatching invalid UTF-8 text fails search instead of successful absence"
                     :fn (fn corrupt-search [] (with-family false nonmatching-corrupt-text))})
(table.insert tests {:name "cold link descriptions enforce stored-byte bounds before loading metadata"
                     :fn (fn bounded-description [] (with-family false bounded-link-description))})
(table.insert tests {:name "bounded link reads and scans accept canonical absent optional defaults without rewriting"
                     :fn (fn defaults [] (with-family false bounded-link-defaults))})
(table.insert tests {:name "owner dependency matching and unresolved DTOs surface alias cycles without writes"
                     :fn (fn dependencies [] (with-family false alias-dependencies))})
(table.insert tests {:name "nonvisual relation descriptions surface identity depth and cold read failures"
                     :fn (fn resolution-errors [] (with-family false alias-resolution-failures))})

(table.insert tests {:name "discovered nonvisual workflow persists without visual adapters" :fn complete-workflow})

(fn main [] ((. (require :tests/runner) :run-tests) {:name "graph-entity-capabilities" :tests tests}))
{:tests tests :main main}

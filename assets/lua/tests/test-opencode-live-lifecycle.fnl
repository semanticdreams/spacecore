(local {:OpenCodeSessionNode Node} (require :graph/nodes/opencode-session))
(local H (require :tests/opencode-graph-helpers))
(local tests [])

(fn timers []
  (local pending [])
  (fn factory [options]
    (local entry {:callback options.callback :delay-ms options.delay-ms :active? false})
    (table.insert pending entry)
    (fn start [_self] (set entry.active? true))
    (fn cancel [_self] (set entry.active? false))
    {:start start :cancel cancel :drop cancel})
  (fn fire! []
    (var target nil)
    (each [_ entry (ipairs pending)]
      (when (and entry.active? (not target)) (set target entry)))
    (assert target "expected scheduled retry")
    (set target.active? false)
    (target.callback))
  {:factory factory :pending pending :fire! fire!})

(fn fixture [synchronous-health? throw-subscribe?]
  (local client (H.make-client-stub))
  (local clock (timers))
  (local streams [])
  (fn subscribe [on-event on-health]
    (assert (= (type on-event) :function) "subscribe-with-health is a dot-call API")
    (assert (= (type on-health) :function))
    (when throw-subscribe? (error "subscribe failed"))
    (local stream {:on-event on-event :on-health on-health :unsubscribed 0})
    (fn unsubscribe [] (set stream.unsubscribed (+ stream.unsubscribed 1)))
    (tset stream :unsubscribe unsubscribe)
    (table.insert streams stream)
    (when synchronous-health? (on-health {:kind :stream-done}))
    stream)
  (fn events [_client] {:subscribe-with-health subscribe})
  (local node (Node {:id "ses_1" :ensure-client (H.ensure-from client)
                     :events-factory events
                     :timer-factory clock.factory}))
  {:node node :client client :clock clock :streams streams})

(fn settle! [f]
  (H.deliver f.client "/session/ses_1" (H.ok-response {:id "ses_1"}))
  (H.deliver f.client "/session/ses_1/message" (H.ok-response [])))
(fn event [] {:type "message.updated" :properties {:sessionID "ses_1"}})

(fn required-pair-barrier []
  (each [_ first (ipairs ["/session/ses_1" "/session/ses_1/message"])]
    (local f (fixture false false))
    (f.node:fetch)
    (local data (if (= first "/session/ses_1") {:id "ses_1"} []))
    (H.deliver f.client first (H.ok-response data))
    (local before (length f.client.pending))
    (for [_ 1 20] ((. f.streams 1 :on-event) (event)))
    (assert (= (length f.client.pending) before) "events cannot supersede an incomplete required pair")
    (assert f.node.pending-invalidation)
    (local second (if (= first "/session/ses_1") "/session/ses_1/message" "/session/ses_1"))
    (H.deliver f.client second (H.ok-response (if (= second "/session/ses_1") {:id "ses_1"} [])))
    (assert (= (length f.client.pending) (+ before 4)) "required pair completion drains exactly one invalidation")
    (assert (not f.node.pending-invalidation))
    (settle! f)
    (assert (not f.node.snapshot-in-flight?))
    ((. f.streams 1 :on-event) (event))
    (assert (= (length f.client.pending) (+ before 8)) "config/children need not settle before the next snapshot")
    (f.node:drop)))

(fn retry-epochs-and-drop []
  (local f (fixture false false))
  (f.node:fetch)
  (settle! f)
  (local old (. f.streams 1))
  (old.on-health {:kind :stream-done})
  (assert (= (length f.streams) 1) "health loss must back off, not immediately recurse")
  (assert (= old.unsubscribed 1))
  (f.clock.fire!)
  (assert (= (length f.streams) 2))
  (local before (length f.client.pending))
  (old.on-health {:kind :stream-done})
  (old.on-event (event))
  (assert (= (. f.streams 2 :unsubscribed) 0) "old callbacks cannot detach a replacement")
  (assert (= (length f.client.pending) before))
  ((. f.streams 2 :on-health) {:kind :parse-error})
  (local delayed (. f.clock.pending (length f.clock.pending)))
  (f.node:drop)
  (assert (not delayed.active?))
  (delayed.callback)
  (old.on-event (event))
  (assert (= (length f.streams) 2) "dropped nodes cannot restart")
  (assert (= (length f.client.pending) before))
  (local ok (pcall f.node.fetch f.node))
  (assert (not ok)))

(fn bounded-consecutive-retries []
  (local f (fixture false false))
  (f.node:fetch)
  (for [i 1 3]
    ((. f.streams i :on-health) {:kind :stream-done})
    (assert (= (. f.clock.pending i :delay-ms) (* 250 (^ 2 (- i 1)))))
    (f.clock.fire!))
  ((. f.streams 4 :on-event) {:type "server.connected"})
  ((. f.streams 4 :on-health) {:kind :stream-done})
  (assert (= (. f.clock.pending 4 :delay-ms) 250) "actual event resets consecutive outage budget")
  (f.clock.fire!)
  (for [i 5 7]
    ((. f.streams i :on-health) {:kind :stream-done})
    (when (< i 7) (f.clock.fire!)))
  (assert (= f.node.live-state :stopped) "persistent outage eventually stops automatic retries")
  (local before (length f.streams))
  ((. f.node.actions 1 :fn) nil nil)
  (assert (= (length f.streams) (+ before 1)) "explicit refresh restarts an exhausted stream")
  (f.node:drop))

(fn synchronous-failures []
  (each [_ throw? (ipairs [true false])]
    (local f (fixture (not throw?) throw?))
    (local (ok err) (pcall f.node.fetch f.node))
    (assert ok err)
    (assert (= (length f.client.pending) 4) "sync stream failure cannot recursively duplicate snapshots")
    (assert f.node.live-error "stream failure must remain explicit")
    (assert (= (length f.clock.pending) 1))
    (when (not throw?) (assert (= (. f.streams 1 :unsubscribed) 1)))
    (f.node:drop)))

(fn duplicate-responses-do-not-complete-new-fetch []
  (local f (fixture false false))
  (f.node:fetch)
  (local messages (. (H.pending-for f.client "/session/ses_1/message") 1))
  (settle! f)
  ((. f.streams 1 :on-event) (event))
  (messages.respond (H.ok-response []))
  (assert f.node.snapshot-in-flight?)
  (H.deliver f.client "/session/ses_1" (H.ok-response {:id "ses_1"}))
  (assert f.node.snapshot-in-flight?)
  (f.node:drop))

(fn production-events-adapter []
  (local client (H.make-client-stub))
  (var callback nil)
  (var cancelled? false)
  (fn request [options] (set callback options.callback) "stream-1")
  (fn cancel [_id] (set cancelled? true))
  (fn base-url [] "http://fixture.invalid")
  (fn http-binding [] {:request request :cancel cancel})
  (tset client :base-url base-url)
  (tset client :http-binding http-binding)
  (local node (Node {:id "ses_1" :ensure-client (H.ensure-from client)}))
  (node:fetch)
  (assert callback "default Events/SSE adapter must actually subscribe")
  (assert (= node.live-state :live))
  (settle! {:node node :client client})
  (callback {:chunk "data: {\"type\":\"message.updated\",\"sessionID\":\"ses_1\"}\n\n"})
  (assert (= (length client.pending) 8) "real SSE adapter events must invalidate snapshots")
  (node:drop)
  (assert cancelled?))

(table.insert tests {:name "required session and transcript pair coalesces both response orders" :fn required-pair-barrier})
(table.insert tests {:name "stream epochs reject old callbacks and cancel retry on drop" :fn retry-epochs-and-drop})
(table.insert tests {:name "stream retries back off bound and reset on demonstrated health" :fn bounded-consecutive-retries})
(table.insert tests {:name "synchronous subscription failures stay explicit and bounded" :fn synchronous-failures})
(table.insert tests {:name "duplicate obsolete responses cannot settle another snapshot" :fn duplicate-responses-do-not-complete-new-fetch})
(table.insert tests {:name "session subscribes through production Events and SSE adapters" :fn production-events-adapter})
(fn main [] ((. (require :tests/runner) :run-tests) {:name "opencode-live-lifecycle" :tests tests}))
{:name "opencode-live-lifecycle" :tests tests :main main}

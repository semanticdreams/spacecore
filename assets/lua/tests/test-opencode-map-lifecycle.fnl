(local Graph (require :graph/init))
(local {:GraphMap GraphMap} (require :graph/map))
(local Extension (require :graph/extensions/builtins/opencode-sessions))
(local H (require :tests/opencode-graph-helpers))
(local tests [])
(local messages-key "opencode-session-messages:ses_1")
(local parts-key "opencode-session-message-parts:ses_1/msg-1")
(local message-key "opencode-session-message:ses_1/msg-1")
(local part-key "opencode-session-message-part:ses_1/msg-1/p1")
(local messages-island "opencode-messages:ses_1")
(local parts-island "opencode-parts:ses_1/msg-1")
(local second-message-key "opencode-session-message:ses_1/msg-2")

(fn message-record [id]
  {:info {:id id :role "user"} :parts []})

(fn assert-edge [map source-key target-key label]
  (local edge (assert (. map.edge-map (.. source-key "->" target-key))
                      (.. "missing relationship edge " source-key "->" target-key)))
  (assert (= edge.source (map:lookup source-key)))
  (assert (= edge.target (map:lookup target-key)))
  (assert (= edge.label label))
  edge)

(fn fixture [synchronous?]
  (local messages [{:info {:id "msg-1" :role "assistant" "future/field" {:flag false}}
                    :parts [{:id "p1" :type "text" :text "hello"}]}])
  (local data {"/config" {} "/session/ses_1/children" []
              "/session/ses_1" {:id "ses_1"} "/session/ses_1/message" messages})
  (local client (H.make-client-stub))
  (when synchronous?
    (set client.submit
         (fn [_method path options]
           (options.on_response (H.ok-response (assert (. data path) path))))))
  (local graph (Graph {:with-start false}))
  (H.install-descriptor (Extension.descriptors {:opencode-ensure-client (H.ensure-from client)}) graph)
  (local map (GraphMap {:graph graph :id "opencode-lifecycle"}))
  (fn settle! []
    (H.deliver client "/session/ses_1/message" (H.ok-response messages))
    (H.deliver client "/session/ses_1" (H.ok-response {:id "ses_1"})))
  (fn drop [] (map:drop) (graph:drop))
  {:graph graph :map map :client client :messages messages :settle! settle! :drop drop})

(fn assert-members [map id keys]
  (local island (assert (map:get-island id) (.. "missing island " id)))
  (assert (= (length island.members) (length keys)))
  (each [i key (ipairs keys)]
    (assert (= (. island.members i) key))
    (local member (assert (map:lookup key) key))
    (assert (= member.key key))
    (assert (= member.graph map))
    (assert (= member.state :ready)))
  island)

(fn synchronous-and-deferred []
  (each [_ synchronous? (ipairs [true false])]
    (local f (fixture synchronous?))
    (local owner (f.map:load-by-key messages-key))
    (when (not synchronous?) (f.settle!))
    (assert (= owner.graph f.map))
    (assert-members f.map messages-island [message-key])
    (local parts (f.map:load-by-key parts-key))
    (assert-members f.map parts-island [part-key])
    (assert (= (. (f.map:lookup part-key) :part :text) "hello"))
    (assert-edge f.map messages-key message-key "message")
    (assert-edge f.map parts-key part-key "part")
    (assert (= (f.map:edge-count) 2) "each enumerated member needs its relationship edge")
    (owner:open-message (. f.messages 1))
    (parts:open-part (. parts.parts 1))
    (assert (= (f.map:edge-count) 2) "row activation must not duplicate batch edges")
    (f.drop)))

(fn child-only-hydration []
  (local f (fixture true))
  (local part (f.map:load-by-key part-key))
  (assert (= part.state :ready))
  (assert (= part.parent (f.map:lookup message-key)))
  (assert (f.map:lookup "opencode-session:ses_1"))
  (assert (= (f.map:lookup messages-key) nil) "ancestors do not invent enumeration owners")
  (assert (= (f.map:lookup parts-key) nil))
  (assert (= (f.map:edge-count) 0) "leaf hydration must not invent enumeration edges")
  (f.drop))

(fn saved-topology-and-replacement []
  (local f (fixture true))
  (f.map:load-by-key messages-key)
  (f.map:load-by-key parts-key)
  (local island (f.map:get-island messages-island))
  (set island.state.position [101 202 303])
  (f.map:upsert-island island)
  (f.map:refresh-adapters-by-scheme "opencode-session-messages")
  (assert (= (. (f.map:get-island messages-island) :state :position 1) 101)
          "same-key replacement preserves dragged presentation")
  (local saved (f.map:capture-state))
  (f.map:restore-state saved)
  (assert-members f.map messages-island [message-key])
  (assert-members f.map parts-island [part-key])
  (assert-edge f.map messages-key message-key "message")
  (assert-edge f.map parts-key part-key "part")
  (assert (= (. (f.map:get-island messages-island) :state :position 1) 101))
  (set saved.islands [])
  (f.map:install-reference-state! saved)
  (assert-members f.map messages-island [message-key])
  (assert-members f.map parts-island [part-key])
  (assert-edge f.map messages-key message-key "message")
  (assert-edge f.map parts-key part-key "part")
  (f.drop))

(fn empty-removal-and-cleanup []
  (local f (fixture true))
  (local owner (f.map:load-by-key messages-key))
  (local parts (f.map:load-by-key parts-key))
  (local session (f.map:lookup "opencode-session:ses_1"))
  (set session.messages [])
  (session.changed:emit session)
  (assert (= (f.map:get-island messages-island) nil))
  (assert (= parts.state :absent))
  (assert (= (f.map:get-island parts-island) nil))
  (assert (= (f.map:edge-count) 2) "snapshot absence retains independently materialized edges")
  (f.map:remove-nodes [owner parts])
  (assert (= (f.map:edge-count) 0) "owner removal prunes its incident edges")
  (assert (= owner.mounted-graph nil) "drop releases retained map lifetime")
  (assert (= parts.mounted-graph nil))
  (f.drop))

(fn reconciliation-preserves-existing-edges []
  (local f (fixture true))
  (local owner (f.map:load-by-key messages-key))
  (local edge (assert-edge f.map messages-key message-key "message"))
  (set edge.label "custom relationship")
  (set edge.color ((. (require :glm) :vec4) 0.1 0.2 0.3 1))
  (set edge._opts {:custom true})
  (var notifications 0)
  (f.map.edge-added:connect (fn [_] (set notifications (+ notifications 1))))
  (owner:recompute)
  (owner:recompute)
  (assert (= notifications 0) "unchanged enumeration must not re-emit edge-added")
  (assert (= (assert-edge f.map messages-key message-key "custom relationship") edge))
  (assert edge._opts.custom)
  (local color edge.color)
  (table.insert f.messages (message-record "msg-2"))
  (local session (f.map:lookup "opencode-session:ses_1"))
  (session.changed:emit session)
  (assert (= notifications 1) "append authors only the missing edge")
  (assert-edge f.map messages-key second-message-key "message")
  (assert (= edge.color color))
  (set session.messages [(message-record "msg-2")])
  (session.changed:emit session)
  (assert-members f.map messages-island [second-message-key])
  (assert (= (f.map:edge-count) 2) "shrinking island membership does not delete authored edges")
  (local saved (f.map:capture-state))
  (f.map:restore-state saved)
  (local restored (assert-edge f.map messages-key message-key "custom relationship"))
  (assert (= restored.color.x color.x))
  (assert (= (f.map:edge-count) 2))
  (f.map:remove-nodes [(f.map:lookup message-key)])
  (assert (= (f.map:edge-count) 1) "endpoint removal prunes its edge")
  (f.drop))

(fn guards-retain-topology-until-fresh []
  (local f (fixture true))
  (local owner (f.map:load-by-key messages-key))
  (local session (f.map:lookup "opencode-session:ses_1"))
  (table.insert f.messages (message-record "msg-2"))
  (set session.messages-stale true)
  (session.changed:emit session)
  (assert (= (f.map:lookup second-message-key) nil))
  (assert (= (f.map:edge-count) 1))
  (set session.messages-stale false)
  (set session.transcript-error "failed refresh")
  (session.changed:emit session)
  (assert (= (f.map:lookup second-message-key) nil))
  (set session.transcript-error nil)
  (set f.map.installing-topology? true)
  (owner:recompute)
  (assert (= (f.map:lookup second-message-key) nil))
  (set f.map.installing-topology? false)
  (f.map.topology-installed:emit f.map)
  (assert-edge f.map messages-key second-message-key "message")
  (assert-members f.map messages-island [message-key second-message-key])
  (f.drop))

(fn reentrant-owner-removal []
  (each [_ boundary (ipairs [:resolution :edge])]
    (local f (fixture true))
    (table.insert f.messages (message-record "msg-2"))
    (var removed? false)
    (fn remove-owner! []
      (when (not removed?)
        (set removed? true)
        (f.map:remove-nodes [(assert (f.map:lookup messages-key))])))
    (if (= boundary :resolution)
        (do
          (local resolve f.map.resolve-node)
          (set f.map.resolve-node
               (fn [map key]
                 (local target (resolve map key))
                 (when (= key message-key) (remove-owner!))
                 target)))
        (f.map.edge-added:connect
          (fn [payload] (when (= payload.edge.source.key messages-key) (remove-owner!)))))
    (f.map:load-by-key messages-key)
    (assert removed? "the callback boundary must be exercised")
    (assert (= (f.map:lookup messages-key) nil) "publication must not remount a removed owner")
    (assert (= (f.map:get-island messages-island) nil) "removed owner must not recreate its island")
    (assert (= (f.map:edge-count) 0))
    (f.drop)))

(fn reentrant-snapshot-invalidation []
  (each [_ transition (ipairs [:stale :error :loading :superseded])]
    (local f (fixture true))
    (table.insert f.messages (message-record "msg-2"))
    (var changed? false)
    (f.map.edge-added:connect
      (fn [_]
        (when (not changed?)
          (set changed? true)
          (local session (f.map:lookup "opencode-session:ses_1"))
          (if (= transition :stale) (set session.messages-stale true)
              (= transition :error) (set session.transcript-error "interrupted refresh")
              (= transition :loading) (set session.state :loading)
              (set session.messages [(message-record "msg-3")]))
          (session.changed:emit session))))
    (local owner (f.map:load-by-key messages-key))
    (assert changed? "the edge notification must be exercised")
    (assert (= (. f.map.edge-map (.. messages-key "->" second-message-key)) nil)
            "an obsolete pass must not add its next edge")
    (if (= transition :superseded)
        (assert-members f.map messages-island ["opencode-session-message:ses_1/msg-3"])
        (do
          (assert (= (f.map:get-island messages-island) nil))
          (local session (f.map:lookup "opencode-session:ses_1"))
          (set session.messages-stale false)
          (set session.transcript-error nil)
          (set session.state :ready)
          (session.changed:emit session)
          (assert-members f.map messages-island [message-key second-message-key])))
    (assert (not owner.island-syncing?))
    (assert (= (f.map:edge-count) 2))
    (f.drop)))

(fn reentrant-owner-replacement []
  (local f (fixture true))
  (table.insert f.messages (message-record "msg-2"))
  (var old nil)
  (f.map.edge-added:connect
    (fn [payload]
      (when (not old)
        (set old payload.edge.source)
        (f.map:refresh-adapters-by-scheme "opencode-session-messages"))))
  (f.map:load-by-key messages-key)
  (local replacement (f.map:lookup messages-key))
  (assert old "the replacement callback must be exercised")
  (assert (not (= old replacement)))
  (assert (= old.mounted-graph nil))
  (assert (not old.island-syncing?))
  (assert-edge f.map messages-key message-key "message")
  (assert-edge f.map messages-key second-message-key "message")
  (assert-members f.map messages-island [message-key second-message-key])
  (f.drop))

(fn publication-failure-recovers []
  (each [_ boundary (ipairs [:resolution :notification])]
    (local f (fixture true))
    (table.insert f.messages (message-record "msg-2"))
    (local resolve f.map.resolve-node)
    (var handler nil)
    (if (= boundary :resolution)
        (set f.map.resolve-node
             (fn [map key] (if (= key second-message-key) nil (resolve map key))))
        (set handler (f.map.edge-added:connect (fn [_] (error "edge notification failed")))))
    (local (ok err) (pcall f.map.load-by-key f.map messages-key))
    (assert (not ok) "publication failure must propagate")
    (assert (string.find (tostring err)
              (if (= boundary :resolution) "island member failed to materialize" "edge notification failed")
              1 true))
    (local owner (assert (f.map:lookup messages-key)))
    (assert (not owner.island-syncing?) "failure must reset the syncing flag")
    (assert (= (f.map:get-island messages-island) nil))
    (assert (= (f.map:edge-count) (if (= boundary :resolution) 0 1))
            "resolve first; notification failure retains already authored topology")
    (set f.map.resolve-node resolve)
    (when handler (f.map.edge-added:disconnect handler true))
    (owner:recompute)
    (assert (= (f.map:edge-count) 2))
    (assert-members f.map messages-island [message-key second-message-key])
    (f.drop)))

(fn failed-install-clears-barrier []
  (local f (fixture true))
  (var completed 0)
  (f.map.topology-installed:connect (fn [_] (set completed (+ completed 1))))
  (local ok (pcall f.map.restore-state f.map {:nodes [17] :edges [] :islands []}))
  (assert (not ok))
  (assert (not f.map.installing-topology?))
  (assert (= completed 0) "failure must not drain successful post-install work")
  (f.drop))

(fn generic-info-child-hydration []
  (local f (fixture true))
  (local key "opencode-session-message-info:ses_1/msg-1/future%2Ffield")
  (local info (f.map:load-by-key key))
  (assert (= info.key key))
  (assert (= info.field "future/field"))
  (assert (= info.state :ready))
  (assert info.present?)
  (assert (= info.value.flag false))
  (assert (= (f.map:lookup messages-key) nil))
  (local session (f.map:lookup "opencode-session:ses_1"))
  (set session.messages [{:info {:id "msg-1"} :parts []}])
  (session.changed:emit session)
  (assert (not info.present?))
  (local saved (f.map:capture-state))
  (f.map:restore-state saved)
  (local restored (f.map:lookup key))
  (assert restored.present? "child-only info reference rehydrates when field returns")
  (assert (= restored.field "future/field"))
  (f.drop))

(table.insert tests {:name "real OpenCode islands hydrate both levels in both response modes" :fn synchronous-and-deferred})
(table.insert tests {:name "real OpenCode child-only keys acquire ancestors without siblings" :fn child-only-hydration})
(table.insert tests {:name "real OpenCode restore and replacement preserve island state" :fn saved-topology-and-replacement})
(table.insert tests {:name "real OpenCode empty membership and owner removal clean up" :fn empty-removal-and-cleanup})
(table.insert tests {:name "failed map topology installation releases its barrier" :fn failed-install-clears-barrier})
(table.insert tests {:name "generic encoded info child rehydrates through real map restore" :fn generic-info-child-hydration})
(table.insert tests {:name "OpenCode enumeration preserves existing explicit edge metadata and notifications" :fn reconciliation-preserves-existing-edges})
(table.insert tests {:name "OpenCode enumeration respects freshness and topology installation" :fn guards-retain-topology-until-fresh})
(table.insert tests {:name "OpenCode publication cannot resurrect a reentrantly removed owner" :fn reentrant-owner-removal})
(table.insert tests {:name "OpenCode publication abandons invalidated or superseded snapshots" :fn reentrant-snapshot-invalidation})
(table.insert tests {:name "OpenCode publication abandons a reentrantly replaced owner" :fn reentrant-owner-replacement})
(table.insert tests {:name "OpenCode publication failures propagate and allow later convergence" :fn publication-failure-recovers})
(fn main [] ((. (require :tests/runner) :run-tests) {:name "opencode-map-lifecycle" :tests tests}))
{:name "opencode-map-lifecycle" :tests tests :main main}
